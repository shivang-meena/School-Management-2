{
  "name": "student-management-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run start --workspace=@erp/api",
    "dev:client": "npm run start --workspace=@erp/client",
    "build": "npm run build --workspace=@erp/contracts && npm run build --workspaces --if-present",
    "build:client": "npm run build --workspace=@erp/client",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "prisma:generate": "npm run prisma:generate --workspace=@erp/api",
    "prisma:migrate": "npm run prisma:migrate --workspace=@erp/api",
    "prisma:deploy": "npm run prisma:deploy --workspace=@erp/api",
    "prisma:seed": "npm run prisma:seed --workspace=@erp/api",
    "prisma:studio": "npm run prisma:studio --workspace=@erp/api",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
